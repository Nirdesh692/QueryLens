<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>QueryStoreDemoSample</RootNamespace>
    <AssemblyName>QueryStoreDemoSample</AssemblyName>
    <Description>Illustrative .NET 8 console app showing EF Core capture enriched with SQL Server Query Store data (CPU, logical reads). Needs a real SQL Server with Query Store enabled - not built/run in the delivery sandbox. See Phase 5 notes.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\QueryLens.Core\QueryLens.Core.csproj" />
    <ProjectReference Include="..\..\src\QueryLens.EFCore\QueryLens.EFCore.csproj" />
    <ProjectReference Include="..\..\src\QueryLens.SqlServer\QueryLens.SqlServer.csproj" />
  </ItemGroup>

</Project>
