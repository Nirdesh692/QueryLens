<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net472;net48</TargetFrameworks>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>QueryLens.EF6</RootNamespace>
    <AssemblyName>QueryLens.EF6</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Description>EF6 integration for QueryLens: an interceptor that captures query timing and metadata with no changes required to your DbContext or LINQ queries.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EntityFramework" Version="6.4.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QueryLens.Core\QueryLens.Core.csproj" />
  </ItemGroup>

</Project>
