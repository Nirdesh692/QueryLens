<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>QueryLens.SqlServer</RootNamespace>
    <AssemblyName>QueryLens.SqlServer</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Description>SQL Server Query Store integration for QueryLens: reads aggregated query performance data (CPU, logical reads, execution plan) from sys.query_store_* and correlates it with application-captured queries. Takes a plain DbConnection - no SqlClient package dependency, works with any adapter's connection including a QueryLens.AdoNet-wrapped one.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\QueryLens.Core\QueryLens.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="QueryLens.SqlServer.Tests" />
  </ItemGroup>

</Project>
