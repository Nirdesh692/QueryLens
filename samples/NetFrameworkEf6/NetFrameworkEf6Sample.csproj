<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>NetFrameworkEf6Sample</RootNamespace>
    <AssemblyName>NetFrameworkEf6Sample</AssemblyName>
    <Description>Illustrative .NET Framework 4.7.2 + EF6 console app showing QueryLens registration and reporting. Not built/run in the delivery sandbox - see Phase 2 notes.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EntityFramework" Version="6.4.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\QueryLens.Core\QueryLens.Core.csproj" />
    <ProjectReference Include="..\..\src\QueryLens.EF6\QueryLens.EF6.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="App.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
